# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials.
#
# In production (Render), these are set directly as environment variables
# in the service dashboard, not via this file.

# SSH tunnel into the RaDaR database server
RADAR_SSH_HOST=
RADAR_SSH_PORT=22
RADAR_SSH_USER=
RADAR_SSH_KEY=/path/to/your/private/key

# PostgreSQL database, reached through the SSH tunnel above
RADAR_DB_PORT=5432
RADAR_DB_NAME=radar
RADAR_DB_USER=
RADAR_DB_PASS=
